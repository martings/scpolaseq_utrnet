{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martings/scpolaseq_utrnet/docs/contracts/regulatory-signature-v0.1.schema.json",
  "title": "regulatory-signature/v0.1",
  "type": "object",
  "required": ["schema_version", "dataset", "observations", "modalities", "measurements"],
  "properties": {
    "schema_version": {"const": "regulatory-signature/v0.1"},
    "dataset": {
      "type": "object",
      "required": ["dataset_id"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "source_repository": {"type": ["string", "null"]},
        "source_commit": {"type": ["string", "null"]},
        "species": {"type": ["string", "null"]},
        "reference_genome": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "context_schema": {"type": "object", "additionalProperties": true},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation_id", "context"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "biological_replicate_id": {"type": ["string", "null"]},
          "sample_id": {"type": ["string", "null"]},
          "library_id": {"type": ["string", "null"]},
          "context": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "modalities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["measured", "partially_measured", "not_measured"]},
          "measurement_scale": {"type": ["string", "null"]},
          "normalization": {"type": ["string", "null"]},
          "observation_unit": {"type": ["string", "null"]},
          "source": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measurement_id", "feature_class", "feature_id", "entity_id", "value", "status", "source"],
        "properties": {
          "measurement_id": {"type": "string", "minLength": 1},
          "feature_class": {"enum": ["gene_expression", "differential_expression", "pas_usage", "apa_metric", "transcript_association", "regulatory_region_availability", "regulatory_association", "functional_enrichment", "pathway_activity", "perturbation_response"]},
          "feature_id": {"type": "string", "minLength": 1},
          "entity_id": {"type": "string", "minLength": 1},
          "observation_id": {"type": ["string", "null"]},
          "value": {"type": ["number", "integer", "string", "object", "null"]},
          "unit": {"type": ["string", "null"]},
          "measurement_scale": {"type": ["string", "null"]},
          "normalization": {"type": ["string", "null"]},
          "status": {"enum": ["measured", "experimental_observation", "annotation_derived", "candidate_inferred", "missing_unmeasured", "missing_zero_coverage", "ambiguous"]},
          "coverage": {"type": ["number", "integer", "null"], "minimum": 0},
          "uncertainty": {"type": ["object", "null"]},
          "statistical_support": {"type": ["object", "null"]},
          "source": {"type": "object"},
          "program_id": {"type": "string"},
          "program_source": {"type": "string"},
          "program_version": {"type": "string"},
          "contributing_gene_ids": {"type": "array", "items": {"type": "string"}},
          "gene_universe_n": {"type": "integer", "minimum": 0},
          "activity_method": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
